<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.tgcv</groupId>
  <artifactId>tgcv-viatra-v002-cps-p2-bridge</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <properties>
    <tycho.version>1.0.0</tycho.version>
    <java.version>1.8</java.version>
  </properties>
  <repositories>
    <repository>
      <id>eclipse-oxygen</id>
      <url>https://download.eclipse.org/releases/oxygen/201710111001</url>
      <layout>p2</layout>
    </repository>
  </repositories>
  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho.version}</version>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <target>
            <file>../target-definition/tgcv-viatra-v002-target.target</file>
          </target>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <modules>
    <module>bundles/org.eclipse.viatra.examples.cps.model</module>
    <module>bundles/org.eclipse.viatra.examples.cps.deployment</module>
    <module>bundles/org.eclipse.viatra.examples.cps.traceability</module>
    <module>bundles/org.eclipse.viatra.examples.cps.xform.m2m.util</module>
    <module>features/org.tgcv.viatra.v002.cps.feature</module>
    <module>repository</module>
  </modules>
</project>
